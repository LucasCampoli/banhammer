# Contact included in the Scryfall User-Agent (their API rules ask for an identifiable agent)
BANHAMMER_CONTACT=you@example.com
OPENAI_API_KEY=
PINECONE_API_KEY=
# OpenAI-compatible endpoint. The course keys go through the ITBA LiteLLM proxy;
# delete this line to call api.openai.com directly with your own key.
OPENAI_BASE_URL=https://sa-llmproxy.it.itba.edu.ar
